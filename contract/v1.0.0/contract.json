          "maximum": null,
          "minimum": null,
          "name": "contributing_factors",
          "pattern": null,
          "required": true,
          "type": "list of enum",
          "unit": null
        },
        {
          "allowed": "clear, rain, fog, dust_sand, strong_wind, other",
          "description_ar": "حالة الطقس وقت وقوع الحادث.",
          "description_en": "Weather at the time of the crash.",
          "enum": [
            "clear",
            "rain",
            "fog",
            "dust_sand",
            "strong_wind",
            "other"
          ],
          "example": "clear",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "weather",
          "pattern": null,
          "required": true,
          "type": "enum",
          "unit": null
        },
        {
          "allowed": "daylight, dark_lit, dark_unlit, dawn_dusk",
