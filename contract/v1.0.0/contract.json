        {
          "allowed": null,
          "description_ar": "معرّف الحادث ضمن ملف الجهة المنتجة.",
          "description_en": "Identifier of the crash within the producer's feed.",
          "enum": [],
          "example": "B-2023-000123",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "crash_id",
          "pattern": "^[A-Z0-9_\\-]{3,40}$",
          "required": true,
          "type": "identifier",
          "unit": null
        },
        {
          "allowed": null,
          "description_ar": "الجهة المنتجة التي أبلغت عن الحادث.",
          "description_en": "Producer that reported the crash.",
          "enum": [],
          "example": "PRODUCER_B",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "producer_id",
          "pattern": "^[A-Z0-9_\\-]{3,40}$",
          "required": true,
          "type": "identifier",
          "unit": null
        },
        {
