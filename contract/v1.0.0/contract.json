          "description_en": "Light condition at the time of the crash.",
          "enum": [
            "daylight",
            "dark_lit",
            "dark_unlit",
            "dawn_dusk"
          ],
          "example": "daylight",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "light_condition",
          "pattern": null,
          "required": true,
          "type": "enum",
          "unit": null
        },
        {
          "allowed": "dry, wet, sand_covered, damaged, other",
          "description_ar": "حالة سطح الطريق وقت وقوع الحادث.",
