          "example": "dry",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "road_surface",
          "pattern": null,
          "required": true,
          "type": "enum",
          "unit": null
        }
      ],
      "schema": "v1.0.0/crash_records.schema.json",
      "title_ar": "سجلات الحوادث",
