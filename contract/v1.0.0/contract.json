          "example": 2,
          "feed": "crash_records",
          "maximum": 20,
          "minimum": 1,
          "name": "vehicles_involved",
          "pattern": null,
          "required": true,
          "type": "integer",
          "unit": "vehicles"
        },
        {
          "allowed": "rear_end, side_impact, head_on, rollover, run_off_road, pedestrian, fixed_object, other",
          "description_ar": "نوع التصادم.",
          "description_en": "Manner of collision.",
          "enum": [
            "rear_end",
            "side_impact",
            "head_on",
            "rollover",
            "run_off_road",
            "pedestrian",
            "fixed_object",
            "other"
          ],
          "example": "rear_end",
          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "collision_type",
          "pattern": null,
          "required": true,
          "type": "enum",
          "unit": null
        },
        {
          "allowed": "speeding, tailgating, sudden_swerving, fatigue, distraction, mechanical_failure, weather, other",
