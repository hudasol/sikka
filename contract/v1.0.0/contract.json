          "feed": "crash_records",
          "maximum": null,
          "minimum": null,
          "name": "segment_ref",
          "pattern": "^[A-Z0-9_\\-]{3,40}$",
          "required": false,
          "type": "identifier",
          "unit": null
        },
        {
