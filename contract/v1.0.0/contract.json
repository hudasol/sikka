          "feed": "crash_records",
          "maximum": 180,
          "minimum": -180,
          "name": "lon",
          "pattern": null,
          "required": true,
          "type": "number",
          "unit": "degrees"
        },
        {
          "allowed": null,
          "description_ar": "المقطع الذي نسبت إليه الجهة المنتجة الحادث، إن وجد.",
          "description_en": "Segment the producer assigned the crash to, if any.",
